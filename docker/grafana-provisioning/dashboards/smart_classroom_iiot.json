{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "Real-Time Classroom Temperature vs Humidity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IIoT-Historian" },
          "query": "from(bucket: \"classroom_telemetry\") |> range(start: -15m) |> filter(fn: (r) => r[\"_measurement\"] == \"environmental_telemetry\") |> filter(fn: (r) => r[\"_field\"] == \"temp_filtered\" or r[\"_field\"] == \"humidity\") |> aggregateWindow(every: 2s, fn: mean, createEmpty: false) |> yield(name: \"mean\")"
        }
      ]
    },
    {
      "title": "CO2 Air Quality Concentration (PPM)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "min": 400, "max": 1500,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 800 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IIoT-Historian" },
          "query": "from(bucket: \"classroom_telemetry\") |> range(start: -5m) |> filter(fn: (r) => r[\"_field\"] == \"co2_filtered\") |> last()"
        }
      ]
    },
    {
      "title": "Real-Time Energy Efficiency Gain (%)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IIoT-Historian" },
          "query": "from(bucket: \"classroom_telemetry\") |> range(start: -5m) |> filter(fn: (r) => r[\"_field\"] == \"energy_saved_pct\") |> last()"
        }
      ]
    },
    {
      "title": "ASHRAE / ISO 7730 PMV Comfort Index (-3 Cold to +3 Hot)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB-IIoT-Historian" },
          "query": "from(bucket: \"classroom_telemetry\") |> range(start: -15m) |> filter(fn: (r) => r[\"_field\"] == \"pmv_index\") |> aggregateWindow(every: 2s, fn: mean, createEmpty: false)"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
